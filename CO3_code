import java.util.*;

public class CampusFlowBFS {

    private int vertices;
    private LinkedList<Integer>[] adjList;

    // Constructor
    @SuppressWarnings("unchecked")
    CampusFlowBFS(int v) {

        vertices = v;

        adjList = (LinkedList<Integer>[]) new LinkedList[vertices];

        for (int i = 0; i < vertices; i++) {
            adjList[i] = new LinkedList<>();
        }
    }

    // Connect Campus Facilities
    void addEdge(int source, int destination) {

        adjList[source].add(destination);
        adjList[destination].add(source);
    }

    // Display Campus Connections
    void displayConnections() {

        System.out.println("\nCampus Connections:");

        for (int i = 0; i < vertices; i++) {

            for (int node : adjList[i]) {

                if (i < node) {

                    System.out.println(
                        getFacilityName(i) + " <-> " + getFacilityName(node)
                    );
                }
            }
        }
    }

    // BFS Traversal
    void BFS(int startNode) {

        boolean visited[] = new boolean[vertices];

        Queue<Integer> queue = new LinkedList<>();

        visited[startNode] = true;
        queue.add(startNode);

        System.out.println("\nBFS Traversal:");

        while (!queue.isEmpty()) {

            int node = queue.poll();

            System.out.println("Visited Facility : " + getFacilityName(node));

            for (int neighbor : adjList[node]) {

                if (!visited[neighbor]) {

                    visited[neighbor] = true;
                    queue.add(neighbor);
                }
            }
        }
    }

    // Facility Names
    String getFacilityName(int node) {

        switch (node) {

            case 0:
                return "Admin Block";

            case 1:
                return "Classroom Block";

            case 2:
                return "Computer Lab";

            case 3:
                return "Library";

            case 4:
                return "Faculty Room";

            case 5:
                return "Canteen";

            case 6:
                return "Auditorium";

            default:
                return "Unknown Facility";
        }
    }

    // Main Method
    public static void main(String[] args) {

        CampusFlowBFS campus = new CampusFlowBFS(7);

        // Campus Facility Connections
        campus.addEdge(0, 1);
        campus.addEdge(0, 2);
        campus.addEdge(1, 3);
        campus.addEdge(1, 4);
        campus.addEdge(2, 5);
        campus.addEdge(3, 6);

        System.out.println("CampusFlow - University Campus Resource Management System");
        System.out.println("--------------------------------------------------------");

        // Display Connections
        campus.displayConnections();

        // BFS Traversal
        campus.BFS(0);

        // Campus Monitoring
        System.out.println("\nCampus Monitoring:");
        System.out.println("Checking campus facility connectivity...");
        System.out.println("All campus facilities are connected.");
        System.out.println("Campus resource monitoring completed successfully.");
    }
}
